<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <!-- Admin package testsuites. -->
        <testsuite name="Admin Feature Test">
            <directory suffix="Test.php">packages/Webkul/Admin/tests/Feature</directory>
        </testsuite>

        <!-- Core package testsuites. -->
        <testsuite name="Core Unit Test">
            <directory suffix="Test.php">packages/Webkul/Core/tests/Unit</directory>
        </testsuite>

        <!-- DataGrid package testsuites. -->
        <testsuite name="DataGrid Unit Test">
            <directory suffix="Test.php">packages/Webkul/DataGrid/tests/Unit</directory>
        </testsuite>

        <!-- Installer package testsuites. -->
        <testsuite name="Installer Feature Test">
            <directory suffix="Test.php">packages/Webkul/Installer/tests/Feature</directory>
        </testsuite>

        <!-- Shop package testsuites. -->
        <testsuite name="Shop Feature Test">
            <directory suffix="Test.php">packages/Webkul/Shop/tests/Feature</directory>
        </testsuite>

        <!-- Kun package testsuites. -->
        <testsuite name="PaymentGateway Unit Test">
            <directory suffix="Test.php">packages/Kun/PaymentGateway/tests/Unit</directory>
        </testsuite>

        <testsuite name="Kun Shipping Unit Test">
            <directory suffix="Test.php">packages/Kun/Shipping/tests/Unit</directory>
        </testsuite>

        <testsuite name="SmartLinks Unit Test">
            <directory suffix="Test.php">packages/Kun/SmartLinks/tests/Unit</directory>
        </testsuite>

        <testsuite name="CodVerification Unit Test">
            <directory suffix="Test.php">packages/Kun/CodVerification/tests/Unit</directory>
        </testsuite>

        <testsuite name="Kun Search Unit Test">
            <directory suffix="Test.php">packages/Kun/Search/tests/Unit</directory>
        </testsuite>

        <testsuite name="Analytics Unit Test">
            <directory suffix="Test.php">packages/Kun/Analytics/tests/Unit</directory>
        </testsuite>

        <testsuite name="Kun SEO Unit Test">
            <directory suffix="Test.php">packages/Kun/SEO/tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>

            <directory>packages</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
